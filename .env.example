# ============================================
# CRAWL VIDEO - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Browser Settings
# ============================================
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=45000
PAGE_TIMEOUT=20000

# ============================================
# Google Drive API
# ============================================
# Path to your Google Service Account JSON file
GOOGLE_CREDENTIALS_PATH=config/credentials.json

# Or use OAuth2 (leave GOOGLE_CREDENTIALS_PATH empty)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Drive folder ID for uploads (optional)
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ============================================
# Download Settings
# ============================================
DOWNLOAD_PATH=data/downloads
MAX_CONCURRENT_DOWNLOADS=3
CHUNK_SIZE=1048576

# Video quality preference (comma-separated)
VIDEO_QUALITY_PREFERENCE=720p,1080p,480p

# ============================================
# Anti-Detection Settings
# ============================================
# Enable stealth mode
STEALTH_MODE=true

# Enable human behavior simulation
BEHAVIOR_SIMULATION=true

# Delays (in seconds)
MIN_DELAY_BETWEEN_ACTIONS=2
MAX_DELAY_BETWEEN_ACTIONS=5

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per minute
MAX_REQUESTS_PER_MINUTE=10

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/crawler.log

# ============================================
# Session Management
# ============================================
# Enable session persistence
SESSION_PERSISTENCE=true
SESSION_FILE=data/sessions/session.json

# ============================================
# Proxy Settings (Optional)
# ============================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# ============================================
# Advanced Settings
# ============================================
# Worker threads for concurrent operations
WORKER_THREADS=4

# Retry attempts for failed operations
RETRY_ATTEMPTS=3

# Memory limit
MEMORY_LIMIT=2048MB
